# Copie este archivo como .env (no se sube al repositorio) y llénelo con los datos
# del PROYECTO DE PRUEBA. Lo usan las pruebas (npm run test:rls / test:flujo) y la importación.
# NUNCA ponga aquí la service_role key: no hace falta para nada.

SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=pegue-aqui-la-anon-key

# Usuario administrador creado en Authentication → Users (con rol admin en «perfiles»)
ADMIN_EMAIL=correo-del-admin@ejemplo.com
ADMIN_PASSWORD=contraseña-del-admin
